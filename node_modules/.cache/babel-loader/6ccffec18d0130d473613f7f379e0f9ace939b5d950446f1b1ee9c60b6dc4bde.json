{"ast":null,"code":"import{useState,useRef,useEffect}from'react';function useAudioPlayer(song){let autoPlay=arguments.length>1&&arguments[1]!==undefined?arguments[1]:false;let onStateChange=arguments.length>2?arguments[2]:undefined;const audioRef=useRef(new Audio(song?song.audioSrc:null));const[isPlaying,setIsPlaying]=useState(autoPlay);const[volume,setVolume]=useState(1);useEffect(()=>{if(song){audioRef.current.src=song.audioSrc;if(autoPlay){audioRef.current.play();setIsPlaying(true);}else{setIsPlaying(false);}}},[song,autoPlay]);useEffect(()=>{if(isPlaying){audioRef.current.play();}else{audioRef.current.pause();}},[isPlaying]);useEffect(()=>{audioRef.current.volume=volume;},[volume]);useEffect(()=>{if(onStateChange){onStateChange({isPlaying,volume});}},[isPlaying,volume,onStateChange]);const togglePlay=()=>{setIsPlaying(!isPlaying);};const handleVolumeChange=e=>{setVolume(parseFloat(e.target.value));};return{audioRef,isPlaying,togglePlay,volume,handleVolumeChange};}export default useAudioPlayer;","map":{"version":3,"names":["useState","useRef","useEffect","useAudioPlayer","song","autoPlay","arguments","length","undefined","onStateChange","audioRef","Audio","audioSrc","isPlaying","setIsPlaying","volume","setVolume","current","src","play","pause","togglePlay","handleVolumeChange","e","parseFloat","target","value"],"sources":["C:/Users/Morny/Desktop/spotify clone/src/hooks/useAudioPlayer.js"],"sourcesContent":["import { useState, useRef, useEffect } from 'react';\r\n\r\nfunction useAudioPlayer(song, autoPlay = false, onStateChange) {\r\n  const audioRef = useRef(new Audio(song ? song.audioSrc : null));\r\n  const [isPlaying, setIsPlaying] = useState(autoPlay);\r\n  const [volume, setVolume] = useState(1);\r\n\r\n  useEffect(() => {\r\n    if (song) {\r\n      audioRef.current.src = song.audioSrc;\r\n      if (autoPlay) {\r\n        audioRef.current.play();\r\n        setIsPlaying(true);\r\n      } else {\r\n        setIsPlaying(false);\r\n      }\r\n    }\r\n  }, [song, autoPlay]);\r\n\r\n  useEffect(() => {\r\n    if (isPlaying) {\r\n      audioRef.current.play();\r\n    } else {\r\n      audioRef.current.pause();\r\n    }\r\n  }, [isPlaying]);\r\n\r\n  useEffect(() => {\r\n    audioRef.current.volume = volume;\r\n  }, [volume]);\r\n\r\n  useEffect(() => {\r\n    if (onStateChange) {\r\n      onStateChange({ isPlaying, volume });\r\n    }\r\n  }, [isPlaying, volume, onStateChange]);\r\n\r\n  const togglePlay = () => {\r\n    setIsPlaying(!isPlaying);\r\n  };\r\n\r\n  const handleVolumeChange = (e) => {\r\n    setVolume(parseFloat(e.target.value));\r\n  };\r\n\r\n  return {\r\n    audioRef,\r\n    isPlaying,\r\n    togglePlay,\r\n    volume,\r\n    handleVolumeChange,\r\n  };\r\n}\r\n\r\nexport default useAudioPlayer;\r\n"],"mappings":"AAAA,OAASA,QAAQ,CAAEC,MAAM,CAAEC,SAAS,KAAQ,OAAO,CAEnD,QAAS,CAAAC,cAAcA,CAACC,IAAI,CAAmC,IAAjC,CAAAC,QAAQ,CAAAC,SAAA,CAAAC,MAAA,IAAAD,SAAA,MAAAE,SAAA,CAAAF,SAAA,IAAG,KAAK,IAAE,CAAAG,aAAa,CAAAH,SAAA,CAAAC,MAAA,GAAAD,SAAA,IAAAE,SAAA,CAC3D,KAAM,CAAAE,QAAQ,CAAGT,MAAM,CAAC,GAAI,CAAAU,KAAK,CAACP,IAAI,CAAGA,IAAI,CAACQ,QAAQ,CAAG,IAAI,CAAC,CAAC,CAC/D,KAAM,CAACC,SAAS,CAAEC,YAAY,CAAC,CAAGd,QAAQ,CAACK,QAAQ,CAAC,CACpD,KAAM,CAACU,MAAM,CAAEC,SAAS,CAAC,CAAGhB,QAAQ,CAAC,CAAC,CAAC,CAEvCE,SAAS,CAAC,IAAM,CACd,GAAIE,IAAI,CAAE,CACRM,QAAQ,CAACO,OAAO,CAACC,GAAG,CAAGd,IAAI,CAACQ,QAAQ,CACpC,GAAIP,QAAQ,CAAE,CACZK,QAAQ,CAACO,OAAO,CAACE,IAAI,CAAC,CAAC,CACvBL,YAAY,CAAC,IAAI,CAAC,CACpB,CAAC,IAAM,CACLA,YAAY,CAAC,KAAK,CAAC,CACrB,CACF,CACF,CAAC,CAAE,CAACV,IAAI,CAAEC,QAAQ,CAAC,CAAC,CAEpBH,SAAS,CAAC,IAAM,CACd,GAAIW,SAAS,CAAE,CACbH,QAAQ,CAACO,OAAO,CAACE,IAAI,CAAC,CAAC,CACzB,CAAC,IAAM,CACLT,QAAQ,CAACO,OAAO,CAACG,KAAK,CAAC,CAAC,CAC1B,CACF,CAAC,CAAE,CAACP,SAAS,CAAC,CAAC,CAEfX,SAAS,CAAC,IAAM,CACdQ,QAAQ,CAACO,OAAO,CAACF,MAAM,CAAGA,MAAM,CAClC,CAAC,CAAE,CAACA,MAAM,CAAC,CAAC,CAEZb,SAAS,CAAC,IAAM,CACd,GAAIO,aAAa,CAAE,CACjBA,aAAa,CAAC,CAAEI,SAAS,CAAEE,MAAO,CAAC,CAAC,CACtC,CACF,CAAC,CAAE,CAACF,SAAS,CAAEE,MAAM,CAAEN,aAAa,CAAC,CAAC,CAEtC,KAAM,CAA